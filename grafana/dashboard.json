          "rawSql": "SELECT\r\n  executed_at    AS time,\r\n  average_price  AS price,\r\n  order_side     AS side\r\nFROM orders o\r\nJOIN portfolios p ON o.portfolio_id = p.portfolio_id\r\nWHERE\r\n  p.portfolio_name = '${Portfolio}'\r\n  AND order_category = 'spot'\r\n  AND order_side = 'sell'\r\n  AND order_status = 'executed'\r\nORDER BY time\r\n",
