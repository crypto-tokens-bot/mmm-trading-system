          "pluginVersion": "4.8.2",
          "queryType": "table",
          "rawSql": "SELECT\r\n  portfolio_name,\r\n  current_value - initial_balance AS unrealized_pnl\r\nFROM (\r\n  SELECT\r\n    portfolio_id,\r\n    any(portfolio_name) AS portfolio_name,\r\n    sum(toFloat64(managed_assets[asset]) * toFloat64(current_prices[asset])) AS current_value,\r\n    any(initial_balance) AS initial_balance\r\n  FROM portfolios\r\n  ARRAY JOIN mapKeys(managed_assets) AS asset\r\n  GROUP BY portfolio_id\r\n)",
          "refId": "A"
        }
      ],
      "title": "Unrealized PnL",
      "type": "barchart"
