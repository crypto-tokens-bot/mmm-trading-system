          "pluginVersion": "4.8.2",
          "queryType": "table",
          "rawSql": "SELECT\r\n  time,\r\n  sum(executed_orders) OVER (ORDER BY time) AS cumulative_executed_orders\r\nFROM (\r\n  SELECT\r\n    toStartOfMinute(executed_at) AS time,\r\n    count() AS executed_orders\r\n  FROM orders\r\n  WHERE order_status = 'executed' AND created_at <= executed_at\r\n  GROUP BY time\r\n  ORDER BY time\r\n)\r\n",
          "refId": "A"
        }
      ],
      "title": "Executed Orders",
      "type": "timeseries"
